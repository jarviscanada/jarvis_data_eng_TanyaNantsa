      "dateCreated": "2024-07-03T20:16:30+0000",
      "status": "READY",
      "$$hashKey": "object:4741"
    },
    {
      "text": "-- To load data into the Parquet table from the wdi_opencsv_gs table\nINSERT INTO TABLE wdi_csv_parquet\nSELECT \n    countryName,\n    countryCode,\n    indicatorName,\n    indicatorCode,\n    year,\n    value\nFROM \n    wdi_opencsv_gs;\n",
      "user": "anonymous",
      "dateUpdated": "2024-07-03T20:22:51+0000",
