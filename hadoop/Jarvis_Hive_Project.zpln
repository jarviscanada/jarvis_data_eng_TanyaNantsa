    {
      "text": "CREATE EXTERNAL TABLE wdi_opencsv_gs (\n    countryName STRING,\n    countryCode STRING,\n    indicatorName STRING,\n    indicatorCode STRING,\n    year INT,\n    value DOUBLE\n)\nROW FORMAT SERDE 'org.apache.hadoop.hive.serde2.OpenCSVSerde'\nWITH SERDEPROPERTIES (\n    \"separatorChar\" = \",\",\n    \"quoteChar\" = \"\\\"\"\n)\nSTORED AS TEXTFILE\nLOCATION 'gs://jarvis_data_eng_tanyanantsa/datasets/wdi_2016'\n",
      "user": "anonymous",
      "dateUpdated": "2024-07-08T05:50:27+0000",
      "progress": 0,
      "config": {
