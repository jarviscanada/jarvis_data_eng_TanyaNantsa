    },
    {
      "text": "DROP TABLE IF EXISTS wdi_csv_parquet;\n\nCREATE EXTERNAL TABLE wdi_csv_parquet (\n    countryName STRING,\n    countryCode STRING,\n    indicatorName STRING,\n    indicatorCode STRING,\n    year INT,\n    value DOUBLE\n)\nSTORED AS PARQUET\nLOCATION 'hdfs:///user/edward/hive/wdi/wdi_csv_parquet';\n",
      "user": "anonymous",
      "dateUpdated": "2024-07-03T20:21:59+0000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "text",
          "editOnDblClick": false,
          "completionSupport": false
        },
