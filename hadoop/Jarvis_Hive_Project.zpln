      "text": "WITH ranked_gdp_growth AS (\n    SELECT\n        countryName,\n        year,\n        value AS GDP_growth_value,\n        ROW_NUMBER() OVER (PARTITION BY countryName ORDER BY value DESC) AS rank\n    FROM \n        wdi_csv_parquet\n    WHERE \n        indicatorCode = 'NY.GDP.MKTP.KD.ZG'\n)\n\nSELECT\n    GDP_growth_value,\n    year,\n    countryName\nFROM \n    ranked_gdp_growth\nWHERE \n    rank = 1\nORDER BY \n    countryName;\n",
