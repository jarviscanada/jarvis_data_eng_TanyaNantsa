    },
    {
      "text": "-- Query for wdi_csv_parquet\nSELECT \n    value AS GDP_growth_value, \n    year, \n    countryName\nFROM \n    wdi_csv_parquet\nWHERE \n    year = 2015 \n    AND countryName = 'Canada'\n    AND indicatorCode = 'NY.GDP.MKTP.KD.ZG';\n\n-- Query for wdi_opencsv_text\nSELECT \n    value AS GDP_growth_value, \n    year, \n    countryName\nFROM \n    wdi_opencsv_text\nWHERE \n    year = 2015 \n    AND countryName = 'Canada'\n    AND indicatorCode = 'NY.GDP.MKTP.KD.ZG';\n",
      "user": "anonymous",
      "dateUpdated": "2024-07-03T20:24:14+0000",
      "progress": 0,
      "config": {
